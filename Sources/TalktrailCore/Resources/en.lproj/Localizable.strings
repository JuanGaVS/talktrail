/* English. Keys are already the English text, so only entries whose key is an identifier are needed. */

/* Command-line tool */
"cli.usage" = "talktrail — transcribes calls on this Mac (microphone + system audio). Nothing leaves the Mac.\n\nUSAGE\n  talktrail record [options]                 Records and transcribes until Ctrl+C\n  talktrail transcribe <audio> [options]     Transcribes an existing audio file\n  talktrail locales                          Lists the available languages\n  talktrail fetch-models <folder>            Downloads the speaker identification models\n                                             (only to package the app; the app never downloads anything)\n\nOPTIONS\n  -l, --locale <code>       Language: en-US, es-ES, es-MX… (default: the system's)\n  -o, --output <folder>     Transcripts folder (default: ~/Documents/Transcripts)\n  -d, --duration <s>        Stop automatically after N seconds\n      --no-mic              Don't transcribe the microphone\n      --no-system           Don't transcribe the system audio\n      --me <name>           Label for the microphone (default: \"Me\")\n      --them <name>         Label for the system audio (default: \"Remote\")\n      --no-speakers         Don't tell the speakers apart (no diarization)";
